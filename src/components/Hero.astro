---
import type { PersonalInfo } from '../types';

interface Props {
  personal: PersonalInfo;
}

const { personal } = Astro.props;
---

<section id="home" class="section hero" aria-labelledby="hero-title">
  <img
    class="portrait"
    src="/icon.webp"
    width="128"
    height="128"
    alt={`${personal.name}のプロフィール画像`}
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="stack">
    <h1 id="hero-title">{personal.name}</h1>
    <p class="eyebrow">{personal.title}</p>
    <p class="lead">{personal.description}</p>
  </div>
</section>
