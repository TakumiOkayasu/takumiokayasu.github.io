---
import Header from "../components/Header.astro";
import "../styles/global.css";

type OpenGraphType = "profile" | "website";
type StructuredData = Record<string, unknown> | Array<Record<string, unknown>>;

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: string | URL;
  openGraphType?: OpenGraphType;
  structuredData?: StructuredData;
}

const {
  title,
  description,
  canonical,
  image = "/icon.webp",
  openGraphType = "profile",
  structuredData,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url;
const canonicalUrl =
  canonical instanceof URL
    ? canonical
    : new URL(canonical ?? Astro.url.pathname, baseUrl);
const imageUrl = image instanceof URL ? image : new URL(image, baseUrl);
const siteUrl = new URL("/", baseUrl);
const currentYear = new Date().getFullYear();

const defaultStructuredData: StructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  description,
  url: canonicalUrl.href,
  inLanguage: "ja-JP",
  isPartOf: {
    "@type": "WebSite",
    name: "Takumi Okayasu",
    url: siteUrl.href,
  },
  mainEntity: {
    "@type": "Person",
    name: "Takumi Okayasu",
    url: siteUrl.href,
  },
};

const serializedStructuredData = JSON.stringify(
  structuredData ?? defaultStructuredData,
).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f7fb" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.webp" type="image/webp" />

    <meta property="og:type" content={openGraphType} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Takumi Okayasu" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        let storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem("theme");
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }

        const theme =
          storedTheme === "dark" || storedTheme === "true"
            ? "dark"
            : storedTheme === "light" || storedTheme === "false"
              ? "light"
              : media.matches
                ? "dark"
                : "light";

        root.classList.add("js");
        root.classList.toggle("dark", theme === "dark");
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#151821" : "#f4f7fb");
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={serializedStructuredData}
    ></script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <Header />
    <main id="main-content" class="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <small>&copy; {currentYear} Takumi Okayasu</small>
        <a href="#top">ページ上部へ</a>
      </div>
    </footer>
  </body>
</html>
