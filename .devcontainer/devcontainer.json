{
  "name": "ProfilePage",
  "dockerComposeFile": "compose.yaml",
  "service": "profile",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localWorkspaceFolder}/,target=/workspaces/${localWorkspaceFolderBasename},type=bind",
    "source=${localEnv:HOME}/.claude,target=/mnt/host-claude,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "pizzacat83.codic",
        "sourcegraph.cody-ai",
        "VisualStudioExptTeam.vscodeintellicode",
        "ms-azuretools.vscode-containers",
        "mikestead.dotenv",
        "mhutchie.git-graph",
        "Anthropic.claude-code",
        "oven.bun-vscode",
        "biomejs.biome"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postStartCommand": "ln -sfn /mnt/host-claude ~/.claude",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:latest": {
      "moby": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:latest": {}
  }
}
